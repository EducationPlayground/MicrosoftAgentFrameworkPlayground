@page
@model DocumentsModel
@{
    ViewData["Title"] = "Documents";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-file-earmark-pdf"></i> Document Upload
    </h2>

    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold">Upload PDF</div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="UploadFile" class="form-label fw-semibold">PDF File</label>
                    <input asp-for="UploadFile"
                           type="file"
                           accept=".pdf"
                           class="form-control"
                           required />
                    <span asp-validation-for="UploadFile" class="text-danger"></span>
                </div>

                <button type="submit" id="uploadBtn" class="btn btn-primary px-4">
                    <span id="uploadBtnText">Upload</span>
                    <span id="uploadBtnSpinner" class="spinner-border spinner-border-sm ms-1 d-none" role="status"></span>
                </button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong> @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">
            <strong>Success:</strong> @Model.SuccessMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header fw-semibold">Uploaded Documents</div>
        <div class="card-body p-0">
            @if (Model.Documents.Count == 0)
            {
                <p class="text-muted p-3 mb-0">No documents uploaded yet.</p>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>File Name</th>
                            <th>Pages</th>
                            <th>Chunks</th>
                            <th>Uploaded At</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td>@doc.Id</td>
                                <td>@doc.OriginalFileName</td>
                                <td>@doc.PageCount</td>
                                <td>@doc.TotalChunks</td>
                                <td>@doc.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <form method="post" asp-page-handler="Delete">
                                        <input type="hidden" name="id" value="@doc.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete this document?')">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('form[enctype="multipart/form-data"]').addEventListener('submit', function () {
            document.getElementById('uploadBtn').disabled = true;
            document.getElementById('uploadBtnText').textContent = 'Uploading...';
            document.getElementById('uploadBtnSpinner').classList.remove('d-none');
        });
    </script>
}
