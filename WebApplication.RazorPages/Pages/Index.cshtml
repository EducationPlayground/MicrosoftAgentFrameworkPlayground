@page
@model IndexModel
@{
    ViewData["Title"] = "Linear Chat";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="display-6 mb-3">Customer Service Chatbot</h1>
        <p class="text-muted mb-4">Chat with our AI assistant about our products.</p>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <label for="sessionId" class="form-label mb-0" style="display:none;">Session Id</label>
                    <input id="sessionId" class="form-control" style="max-width: 360px; display:none;" readonly />
                    <button id="newChat" type="button" class="btn btn-outline-secondary">Clear Local History</button>
                </div>

                <div id="chatHistory" class="border rounded p-3 mb-3 d-flex flex-column gap-3" style="height: 450px; overflow-y: auto; background: #fafafa;"></div>

                <form id="chatForm">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <input id="messageInput" class="form-control" placeholder="Ask about products, prices or stock..." autocomplete="off" />
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-send"></i> Send
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const sessionStorageKey = "basic-linear-chat-session-id";
    const historyStoragePrefix = "basic-linear-chat-history-";

    const sessionIdInput = document.getElementById("sessionId");
    const chatHistory = document.getElementById("chatHistory");
    const chatForm = document.getElementById("chatForm");
    const messageInput = document.getElementById("messageInput");
    const newChatButton = document.getElementById("newChat");
    const antiForgeryToken = document.querySelector("input[name='__RequestVerificationToken']").value;

    const createSessionId = () => {
        if (window.crypto && crypto.randomUUID) {
            return crypto.randomUUID();
        }

        return `${Date.now()}-${Math.random().toString(16).slice(2)}`;
    };

    const getSessionId = () => {
        const existing = localStorage.getItem(sessionStorageKey);
        if (existing) {
            return existing;
        }

        const generated = createSessionId();
        localStorage.setItem(sessionStorageKey, generated);
        return generated;
    };

    const setSessionId = (value) => {
        localStorage.setItem(sessionStorageKey, value);
        sessionIdInput.value = value;
    };

    const getHistoryKey = (sessionId) => `${historyStoragePrefix}${sessionId}`;

    const loadLocalHistory = (sessionId) => {
        const raw = localStorage.getItem(getHistoryKey(sessionId));
        if (!raw) {
            return [];
        }

        try {
            const parsed = JSON.parse(raw);
            return Array.isArray(parsed) ? parsed : [];
        } catch {
            return [];
        }
    };

    const saveLocalHistory = (sessionId, history) => {
        localStorage.setItem(getHistoryKey(sessionId), JSON.stringify(history));
    };

    const renderHistory = (history) => {
        chatHistory.innerHTML = "";

        if (!history.length) {
            chatHistory.innerHTML = '<p class="text-muted mb-0">No messages yet.</p>';
            return;
        }

        history.forEach(item => {
            const wrapper = document.createElement("div");
            wrapper.className = "d-flex w-100 flex-column";

            const isUser = (item.role || "assistant").toLowerCase() === "user";

            wrapper.innerHTML = `
                <div class="p-2 rounded ${isUser ? 'bg-primary text-white align-self-end' : 'bg-white border align-self-start'}" style="max-width: 80%;">
                    <div class="small ${isUser ? 'text-white-50' : 'text-muted'} mb-1">${isUser ? 'You' : 'Assistant'}</div>
                    <div class="message-content">${escapeHtml(item.content || "").replace(/\n/g, '<br/>')}</div>
                </div>
            `;

            chatHistory.appendChild(wrapper);
        });

        chatHistory.scrollTop = chatHistory.scrollHeight;
    };

    const escapeHtml = (value) => value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");

    const initialize = () => {
        const sessionId = getSessionId();
        sessionIdInput.value = sessionId;
        renderHistory(loadLocalHistory(sessionId));
    };

    newChatButton.addEventListener("click", () => {
        const sessionId = createSessionId();
        setSessionId(sessionId);
        renderHistory([]);
    });

    chatForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        const message = messageInput.value.trim();
        if (!message) {
            return;
        }

        const sessionId = sessionIdInput.value;
        const currentHistory = loadLocalHistory(sessionId);
        currentHistory.push({ role: "user", content: message });
        renderHistory(currentHistory);
        saveLocalHistory(sessionId, currentHistory);
        messageInput.value = "";

        try {
            const response = await fetch("/?handler=Chat", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": antiForgeryToken
                },
                body: JSON.stringify({ message })
            });

            const payload = await response.json();
            if (!response.ok) {
                throw new Error(payload?.error || "Request failed.");
            }

            // We update the session Id dynamically if returned by the backend
            if (payload.sessionId) {
                setSessionId(payload.sessionId);
            }

            const normalizedHistory = Array.isArray(payload.history)
                ? payload.history.map(item => ({
                    role: item.role || "assistant",
                    content: item.content || ""
                }))
                : [...currentHistory, { role: "assistant", content: payload.reply || "" }];

            saveLocalHistory(sessionId, normalizedHistory);
            renderHistory(normalizedHistory);
        } catch (error) {
            const failedHistory = loadLocalHistory(sessionId);
            failedHistory.push({ role: "assistant", content: `Error: ${error.message}` });
            saveLocalHistory(sessionId, failedHistory);
            renderHistory(failedHistory);
        }
    });

    initialize();
})();
</script>
}
