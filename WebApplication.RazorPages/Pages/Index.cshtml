@page
@model IndexModel
@{
    ViewData["Title"] = "Linear Chat";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="display-6 mb-3">Customer Service Chatbot</h1>
        <p class="text-muted mb-4">Chat with our AI assistant about our products.</p>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <button id="newChat" type="button" class="btn btn-outline-secondary">Clear Local History</button>
                </div>

                <div id="chatHistory" class="border rounded p-3 mb-3 d-flex flex-column gap-3" style="height: 450px; overflow-y: auto; background: #fafafa;">
                    @if (Model.ChatHistory != null && Model.ChatHistory.Any())
                    {
                        @foreach (var item in Model.ChatHistory)
                        {
                            var isUser = item.Role.Equals("user", StringComparison.OrdinalIgnoreCase);
                            <div class="d-flex w-100 flex-column">
                                <div class="p-2 rounded @(isUser ? "bg-primary text-white align-self-end" : "bg-white border align-self-start")" style="max-width: 80%;">
                                    <div class="small @(isUser ? "text-white-50" : "text-muted") mb-1">@(isUser ? "You" : "Assistant")</div>
                                    <div class="message-content">@Html.Raw(Html.Encode(item.Content).Replace("\n", "<br/>"))</div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <form id="chatForm">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <input id="messageInput" class="form-control" placeholder="Ask about products, prices or stock..." autocomplete="off" />
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-send"></i> Send
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    // Sadece geçmişi kaydetmek için varsayılan bir anahtar kullanıyoruz
    const historyStorageKey = "customer-service-chat-history";

    const chatHistory = document.getElementById("chatHistory");
    const chatForm = document.getElementById("chatForm");
    const messageInput = document.getElementById("messageInput");
    const newChatButton = document.getElementById("newChat");
    const antiForgeryToken = document.querySelector("input[name='__RequestVerificationToken']").value;

    const loadLocalHistory = () => {
        // Tarayıcı local storage'ında artık tutmuyoruz, sadece UI'daki yapıyı korumak adına runtime list olarak dönebilir.
        // Veya doğrudan ekrandaki elementlerden okuyabilirsiniz. Ancak en doğrusu, sayfa yenilendiğinde zaten HTML içinden render olmasıdır.
        const list = [];
        document.querySelectorAll("#chatHistory > div").forEach(item => {
            const role = item.querySelector(".small").textContent.trim() === "You" ? "user" : "assistant";
            const content = item.querySelector(".message-content").innerHTML.replace(/<br\s*\/?>/gi, "\n");
            list.push({ role, content });
        });
        return list;
    };

    const saveLocalHistory = (history) => {
        // Web tarayıcısında artık history tutmuyoruz (localStorage kullanılmıyor)
    };

    const renderHistory = (history) => {
        chatHistory.innerHTML = "";

        if (!history.length) {
            chatHistory.innerHTML = '<p class="text-muted mb-0">No messages yet.</p>';
            return;
        }

        history.forEach(item => {
            const wrapper = document.createElement("div");
            wrapper.className = "d-flex w-100 flex-column";

            const isUser = (item.role || "assistant").toLowerCase() === "user";

            wrapper.innerHTML = `
                <div class="p-2 rounded ${isUser ? 'bg-primary text-white align-self-end' : 'bg-white border align-self-start'}" style="max-width: 80%;">
                    <div class="small ${isUser ? 'text-white-50' : 'text-muted'} mb-1">${isUser ? 'You' : 'Assistant'}</div>
                    <div class="message-content">${escapeHtml(item.content || "").replace(/\\n/g, '<br/>').replace(/\n/g, '<br/>')}</div>
                </div>
            `;

            chatHistory.appendChild(wrapper);
        });

        chatHistory.scrollTop = chatHistory.scrollHeight;
    };

    const escapeHtml = (value) => value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");

    const initialize = () => {
        chatHistory.scrollTop = chatHistory.scrollHeight;
    };

    newChatButton.addEventListener("click", () => {
        chatHistory.innerHTML = '<p class="text-muted mb-0">No messages yet.</p>';
        // Not: Server session verisini silmek için isterseniz backend'e bir istek de atabilirsiniz, 
        // ancak yerel temizlik için sadece ekranı temizliyoruz. Sayfa yenilendiğinde güncel API state'i gelecektir.
    });

    chatForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        const message = messageInput.value.trim();
        if (!message) {
            return;
        }

        const currentHistory = loadLocalHistory();
        currentHistory.push({ role: "user", content: message });
        renderHistory(currentHistory);
        messageInput.value = "";

        try {
            const response = await fetch("/?handler=Chat", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": antiForgeryToken
                },
                body: JSON.stringify({ message })
            });

            const payload = await response.json();
            if (!response.ok) {
                throw new Error(payload?.error || "Request failed.");
            }

            const normalizedHistory = [...currentHistory, { role: "assistant", content: payload.reply || "" }];
            renderHistory(normalizedHistory);
        } catch (error) {
            const failedHistory = loadLocalHistory();
            failedHistory.push({ role: "assistant", content: `Error: ${error.message}` });
            renderHistory(failedHistory);
        }
    });

    initialize();
})();
</script>
}
