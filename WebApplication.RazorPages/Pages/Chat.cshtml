@page
@model ChatModel
@{
    ViewData["Title"] = "Q & A";
}

<style>
    .chat-window {
        height: 60vh;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 16px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

    .bubble-row {
        display: flex;
    }

    .bubble-row.user {
        justify-content: flex-end;
    }

    .bubble-row.assistant {
        justify-content: flex-start;
    }

    .bubble {
        max-width: 75%;
        padding: 10px 14px;
        border-radius: 16px;
        white-space: pre-wrap;
        word-break: break-word;
        font-size: 0.95rem;
    }

    .bubble.user {
        background-color: #0d6efd;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .bubble.assistant {
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        color: #212529;
        border-bottom-left-radius: 4px;
    }

    .sources-toggle {
        font-size: 0.8rem;
        margin-top: 6px;
        cursor: pointer;
        color: #6c757d;
        text-decoration: underline;
        background: none;
        border: none;
        padding: 0;
    }

    .sources-toggle:hover {
        color: #343a40;
    }
</style>

<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="mb-0">
            <i class="bi bi-chat-dots"></i> Document Q &amp; A
        </h2>
        <a href="/Chat" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-plus-circle"></i> Yeni Sohbet
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong> @Model.ErrorMessage
        </div>
    }

    <div class="chat-window mb-3" id="chatWindow">
        @if (Model.Messages.Count == 0)
        {
            <div class="text-center text-muted my-auto">
                <i class="bi bi-chat-left-text fs-2"></i>
                <p class="mt-2">Belgeleriniz hakkında bir soru sorun.</p>
            </div>
        }

        @foreach (var (msg, idx) in Model.Messages.Select((m, i) => (m, i)))
        {
            <div class="bubble-row @msg.Role">
                <div>
                    <div class="bubble @msg.Role">@msg.Content</div>

                    @if (msg.Role == "assistant" && msg.Sources is { Count: > 0 })
                    {
                        var collapseId = $"sources-{idx}";
                        <button class="sources-toggle" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId"
                                aria-expanded="false">
                            @msg.Sources.Count kaynak göster ▾
                        </button>
                        <div class="collapse mt-1" id="@collapseId">
                            <table class="table table-sm table-bordered mb-0" style="font-size:0.8rem; background:#fff;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Belge</th>
                                        <th>Sayfa</th>
                                        <th>İlgi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var src in msg.Sources)
                                    {
                                        <tr>
                                            <td>@src.DocumentName</td>
                                            <td>@src.PageNumber</td>
                                            <td><span class="badge bg-secondary">@src.Relevance.ToString("P1")</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <form method="post" id="chatForm">
        <input type="hidden" asp-for="SessionId" />
        <input type="hidden" asp-for="DocumentId" />

        <div class="input-group">
            <textarea asp-for="Question"
                      class="form-control"
                      rows="2"
                      placeholder="Sorunuzu buraya yazın..."
                      required
                      id="questionInput"></textarea>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-send"></i>
            </button>
        </div>
        <span asp-validation-for="Question" class="text-danger small"></span>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Scroll to bottom of chat window on load
        const chatWindow = document.getElementById('chatWindow');
        if (chatWindow) chatWindow.scrollTop = chatWindow.scrollHeight;

        // Submit on Ctrl+Enter / Cmd+Enter
        document.getElementById('questionInput')?.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                document.getElementById('chatForm').submit();
            }
        });
    </script>
}

